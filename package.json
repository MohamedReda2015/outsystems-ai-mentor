    "os-check-workflow": "scripts/check-workflow.mjs"
  },
  "scripts": {
    "test": "node scripts/check_skill.mjs && node scripts/test.mjs",
    "check:skill": "node scripts/check_skill.mjs"
  },
  "engines": { "node": ">=16" },
  "files": ["SKILL.md", "references/", "templates/", "scripts/", "adapters/", "examples/", "evals/", "research/", "README.md", "CHANGELOG.md", "LICENSE"],
